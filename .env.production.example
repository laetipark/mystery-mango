# 실제 파일은 .env.production.local에 보관합니다. Git에 추가하지 마세요.
# python3 scripts/prepare-production-env.py가 난수 비밀번호로 생성합니다.
DATABASE_USER=mango
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_PRODUCTION_PASSWORD
# 기존 Kakao 앱의 REST API 키와 Client Secret. 운영 전환 전에 입력하세요.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://mystery.laetipark.me/api/v1/auth/kakao/callback
VOICE_PROVIDER=disabled
DISCONNECT_GRACE_SECONDS=120
ABANDON_SECONDS=300
EMPTY_GAME_ABORT_SECONDS=1800
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_REDIRECT_URI=https://mystery.laetipark.me/api/v1/me/discord/callback
DISCORD_INVITE_URL=
