    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-konva": "19.2.5",
    "react-router-dom": "7.18.2",
    "sass": "1.99.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.2",
