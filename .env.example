# Local development only. Replace database credentials for deployment.
DATABASE_USER=mango
DATABASE_PASSWORD=mango_local_only
SPRING_PROFILES_ACTIVE=dev
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
VOICE_PROVIDER=disabled
MATCH_ACCEPT_SECONDS=30
MATCH_VOTE_SECONDS=60
GAME_PHASE_SECONDS=0
DISCONNECT_GRACE_SECONDS=120
ABANDON_SECONDS=300
EMPTY_GAME_ABORT_SECONDS=1800

# Kakao REST API login. Enable Client Secret in Kakao Developers.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

# Optional dedicated Discord guild. Keep actual secrets out of source control.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_REDIRECT_URI=http://localhost:8080/api/v1/me/discord/callback
DISCORD_INVITE_URL=

# 로컬 Java 실행 시 자산 영속 디렉터리. Compose는 author-assets 볼륨을 사용합니다.
ASSET_STORAGE_PATH=./.data/assets
